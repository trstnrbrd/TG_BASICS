# Apache needs a fixed path here (it can't be worked out per request like config/app_url.php does), so this is the
# one line to edit if the app ever moves out of /TG-BASICS/ — e.g. to "ErrorDocument 404 /404.php" at a domain root.
ErrorDocument 404 /TG-BASICS/404.php

# Web app manifest (installable app). Apache has no type for .webmanifest out of the box.
AddType application/manifest+json .webmanifest

# Force HTTPS in production only — checks both the direct flag and the
# forwarded-proto header (some shared hosts terminate SSL at a proxy in
# front of Apache), and skips localhost/XAMPP so local dev is unaffected.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Uploaded client documents (licenses, OR/CR, affidavits, receipts, repair photos) are never served directly —
# only through modules/files/file.php, which checks the signed-in user first (config/uploads.php). This rule
# lives here, not only in uploads/.htaccess, because the deploy workflow skips uploads/ entirely.
# Staff profile photos (uploads/avatars/) stay public.
RewriteRule ^uploads/(claims|client_docs|receipts|repair_jobs)(/|$) - [F,L]

# Weekly full backups (whole database + uploads): never downloadable directly, only through Settings with the
# owner's password (modules/admin/backup_database.php)
RewriteRule ^backups(/|$) - [F,L]

# Compress pages, CSS and JS on the way out (a 300 KB list page is ~40 KB compressed). Skipped where the module is off.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>
